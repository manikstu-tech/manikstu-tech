# Laravel Production .env Template
# Copy this to backend/.env on Hostinger and fill in the values

APP_NAME="Manikstu Agro"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.manikstu.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database (fill in your Hostinger MySQL credentials)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXX_manikstu
DB_USERNAME=uXXXXXX_manikstu_user
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.manikstu.com
SESSION_SECURE_COOKIE=true

# Cache
CACHE_STORE=database
CACHE_PREFIX=manikstu

# Queue
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Mail (configure later)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@manikstu.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite (for backend admin assets)
VITE_APP_NAME="${APP_NAME}"

# Admin (generate a strong password before deploying)
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# CORS (comma-separated origins for production)
CORS_ORIGINS=https://manikstu.com,https://www.manikstu.com,https://api.manikstu.com
