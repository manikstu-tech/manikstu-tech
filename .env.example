# Copy to .env.local for local work. On the live site (Hostinger Node.js app) set the same names in hPanel > Node.js > Environment variables.
# NEXT_PUBLIC_ values are written into the pages when the site is built: after changing one, deploy again.
# Without RESEND_API_KEY the contact, careers and join forms report that they are not set up.

# Email delivery for the contact, careers, investor and partnership forms (https://resend.com)
RESEND_API_KEY=
# A sender on a domain verified in Resend, for example "Manikstu website <hello@manikstu.com>"
CONTACT_FROM_EMAIL=

# Where each form's messages go (all optional)
CONTACT_TO_EMAIL=contact@manikstu.com
CAREERS_TO_EMAIL=hr@manikstu.com
# Investor and Partnership messages from the Join Us page; both fall back to CONTACT_TO_EMAIL
INVESTOR_TO_EMAIL=collaborate@manikstu.com
PARTNERSHIP_TO_EMAIL=collaborate@manikstu.com
# Franchise interest from the Franchise page; falls back to PARTNERSHIP_TO_EMAIL, then CONTACT_TO_EMAIL
FRANCHISE_TO_EMAIL=
# FPO Connect enquiries from the FPO page; falls back to PARTNERSHIP_TO_EMAIL, then CONTACT_TO_EMAIL
FPO_TO_EMAIL=

# Orders, payments and reviews run in the separate manikstu-backend service (it holds the Razorpay keys).
# BACKEND_URL is where it runs, for example http://localhost:4000. BACKEND_API_KEY must equal API_KEY in the backend.
BACKEND_URL=
BACKEND_API_KEY=

# Content admin at /admin (see README, "Content admin"). Without ADMIN_PASSWORD the admin stays closed on the live site,
# and so it does when the password is shorter than 12 characters.
ADMIN_PASSWORD=
# Optional: a long random string that signs the login cookie. Defaults to the password.
ADMIN_SECRET=
# Supabase project settings > API. The service-role key is secret: server only, never share it or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
